# Copy this file to `.env.local` (gitignored) and fill in real values.
#
# Self-hosted Convex requires both variables. The CLI uses these to know
# which backend to push to and how to authenticate.
#
# Get the admin key by running `./generate_admin_key.sh` on the machine
# that hosts the Convex backend (the box behind your CONVEX_SELF_HOSTED_URL).

CONVEX_SELF_HOSTED_URL=https://spyfall-api.walhallaa.dpdns.org
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-output-of-generate_admin_key.sh

# App Store Connect API key (used by deploy.sh for unattended IPA uploads).
# Create at https://appstoreconnect.apple.com → Users and Access → Keys (Team Keys).
# Download the .p8 once and place it at:
#   $APP_STORE_CONNECT_KEY_DIR/AuthKey_<KEY_ID>.p8
# APP_STORE_CONNECT_KEY_DIR defaults to ~/.appstoreconnect/private_keys/TeamMuratCanKoc; override
# it (e.g. with a per-team subdirectory) when juggling multiple Apple Developer teams.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_DIR=$HOME/.appstoreconnect/private_keys/TeamMuratCanKoc
